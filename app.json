{
  "expo": {
    "name": "VitalWatch",
    "slug": "vitalwatch-mobile",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/images/vitalwatch-logo.png",
    "scheme": "vitalwatchmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.vitalwatchmobile",
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/vitalwatch-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vitalwatchmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#DC2626",
          "defaultChannel": "vitalwatch-alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/vitalwatch-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f6f67c0-b4fe-4518-b2ec-ae71dc2bcbf5"
      }
    }
  }
}
