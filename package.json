{
  "name": "vitalwatch-mobile",
  "main": "expo-router/entry",
  "version": "1.0.10",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "firmware:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-setup.ps1",
    "firmware:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-prepare-other-pc.ps1",
    "firmware:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-configure.ps1",
    "firmware:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action build",
    "firmware:stable:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action stable-build",
    "firmware:stable:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action stable-upload",
    "firmware:baseline:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action baseline-build",
    "firmware:bio:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action bio-build",
    "firmware:bio:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action bio-upload",
    "firmware:bio:research": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action bio-research-build",
    "firmware:bio:research:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action bio-research-upload",
    "firmware:bio:replay": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action bio-replay-build",
    "firmware:bio:replay:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action bio-replay-upload",
    "firmware:biosys:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action biosys-build",
    "firmware:biosys:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action biosys-upload",
    "firmware:biosys:research": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action biosys-research-build",
    "firmware:biosys:research:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action biosys-research-upload",
    "firmware:biosys:capture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/capture-biosys-research.ps1",
    "firmware:ports": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action ports",
    "firmware:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action upload",
    "firmware:monitor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action monitor",
    "firmware:tft:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action tft-build",
    "firmware:tft:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/esp32-firmware.ps1 -Action tft-upload",
    "simulate:device": "node --env-file=.env.local --env-file=.env.simulator.local scripts/vitalwatch-simulator.mjs",
    "test:readings": "node --no-warnings --test scripts/test-vitalwatch-readings.mjs",
    "test:telegram": "node --no-warnings --test scripts/test-vitalwatch-telegram.mjs",
    "test:security": "node --env-file=.env.local scripts/test-vitalwatch-security.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.112.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
